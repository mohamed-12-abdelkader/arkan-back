NODE_ENV=development
PORT=8000
# Public HTTPS origin of this API (production), used for payment callbacks/returns
API_PUBLIC_URL=
STORE_CURRENCY=SAR
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
FRONTEND_HOST=http://localhost:3000

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

DATABASE_URL=postgres://user:password@localhost:5432/arkan?sslmode=disable

ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Arkan Store

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Paymob KSA — keys + integration ID must be from the same mode (Test or Live)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_BASE_URL=https://ksa.paymob.com
PAYMOB_COUNTRY=SA
PAYMOB_CURRENCY=SAR
PAYMOB_NOTIFICATION_URL=http://localhost:8000/api/v1/payments/paymob/webhook
PAYMOB_REDIRECTION_URL=http://localhost:3000/checkout/result

# Tamara BNPL — https://docs.tamara.co/
# API Token + Notification Token + Public Key from Tamara Partners Portal / email
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_PUBLIC_KEY=
# Sandbox: https://api-sandbox.tamara.co | Live: https://api.tamara.co
TAMARA_API_URL=https://api-sandbox.tamara.co
TAMARA_COUNTRY_CODE=SA
TAMARA_CURRENCY=SAR
TAMARA_PAYMENT_TYPE=PAY_BY_INSTALMENTS
TAMARA_INSTALMENTS=3
TAMARA_LOCALE=ar_SA
# Leave empty to use backend return routes under /api/v1/payments/tamara/return/*
TAMARA_SUCCESS_URL=
TAMARA_FAILURE_URL=
TAMARA_CANCEL_URL=
# Order total range (SAR) where Tamara is offered (0 = no limit)
TAMARA_MIN_AMOUNT=0
TAMARA_MAX_AMOUNT=0
# VAT rate included in prices, e.g. 0.15 (0 if not VAT-registered)
TAMARA_VAT_RATE=0

# WhatsApp gateway
WHATSAPP_GATEWAY_URL=
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# DeepSeek (AI assistant + WhatsApp reply classification)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
